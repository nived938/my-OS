<UserControl x:Class="NexusOS.Apps.FileManager.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NexusOS.UI;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Native Drag and Drop enabled directly on the root grid -->
    <Grid Background="{DynamicResource NexusBackgroundBrush}"
          AllowDrop="True"
          Drop="FileManager_Drop"
          DragOver="FileManager_DragOver"
          DragEnter="FileManager_DragEnter">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="40" /> <!-- Tabs & Top Toolbar -->
            <RowDefinition Height="42" /> <!-- Navigation & Address Bar -->
            <RowDefinition Height="*" />  <!-- Main Explorer Body (Sidebar + Files Grid) -->
            <RowDefinition Height="28" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Tabs Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="NewTabButton" Content="+" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="4,4" Click="NewTabButton_Click" ToolTip="New Tab" />
                <StackPanel x:Name="TabsContainer" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Navigation, Breadcrumbs & Search -->
        <Border Grid.Row="1" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back, Forward, Up, Refresh -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BackButton" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="BackButton_Click" ToolTip="Back">
                        <TextBlock Text="←" FontWeight="Bold" FontSize="14" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="ForwardButton_Click" ToolTip="Forward">
                        <TextBlock Text="→" FontWeight="Bold" FontSize="14" />
                    </Button>
                    <Button x:Name="UpButton" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="UpButton_Click" ToolTip="Up one folder">
                        <TextBlock Text="↑" FontWeight="Bold" FontSize="14" />
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="RefreshButton_Click" ToolTip="Refresh">
                        <TextBlock Text="↻" FontWeight="Bold" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Address / Path Bar -->
                <TextBox x:Name="AddressTextBox" Grid.Column="1" Style="{StaticResource NexusTextBox}" 
                         VerticalAlignment="Center" KeyDown="AddressTextBox_KeyDown" Margin="0,0,8,0" />

                <!-- Search Box -->
                <TextBox x:Name="SearchBox" Grid.Column="2" Style="{StaticResource NexusTextBox}" 
                         VerticalAlignment="Center" TextChanged="SearchBox_TextChanged" Margin="0,0,8,0" />

                <!-- View Modes (Grid / Details) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="NewFolderButton" Content="New Folder" Style="{StaticResource NexusButtonGhost}" Margin="2,0" Click="NewFolderButton_Click" />
                    <Button x:Name="ViewGridButton" Content="Grid" Style="{StaticResource NexusButtonGhost}" Margin="2,0" Click="ViewGridButton_Click" />
                    <Button x:Name="ViewDetailsButton" Content="Details" Style="{StaticResource NexusButtonGhost}" Margin="2,0" Click="ViewDetailsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Sidebar + Files Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="140" MaxWidth="300" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar Navigation -->
            <Border Grid.Column="0" Background="{DynamicResource NexusSurfaceBrush}" Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Quick Access" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NexusTextSecondaryBrush}" Margin="8,4,0,6" />
                        <ListBox x:Name="SidebarQuickAccess" Background="Transparent" BorderThickness="0" SelectionChanged="Sidebar_SelectionChanged">
                            <ListBoxItem Tag="Home" Content="Home (Workspace)" />
                            <ListBoxItem Tag="Desktop" Content="Desktop" />
                            <ListBoxItem Tag="Documents" Content="Documents" />
                            <ListBoxItem Tag="Downloads" Content="Downloads" />
                            <ListBoxItem Tag="Pictures" Content="Pictures" />
                            <ListBoxItem Tag="Music" Content="Music" />
                            <ListBoxItem Tag="Videos" Content="Videos" />
                        </ListBox>

                        <Separator Background="{DynamicResource NexusBorderSubtleBrush}" Margin="4,8" />

                        <TextBlock Text="Storage &amp; Host" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource NexusTextSecondaryBrush}" Margin="8,4,0,6" />
                        <ListBox x:Name="SidebarHost" Background="Transparent" BorderThickness="0" SelectionChanged="Sidebar_SelectionChanged">
                            <ListBoxItem Tag="NexusDrive" Content="Nexus Storage" />
                            <ListBoxItem Tag="HostDrop" Content="Host Drag-and-Drop Zone" />
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Splitter Line -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource NexusBorderSubtleBrush}" />

            <!-- Files View Area -->
            <Grid Grid.Column="2" Background="{DynamicResource NexusBackgroundBrush}">
                
                <!-- Drag and drop dropzone overlay banner -->
                <Border x:Name="DropBanner" Background="{DynamicResource NexusAccentBrush}" Opacity="0.1" 
                        BorderBrush="{DynamicResource NexusAccentBrush}" BorderThickness="2" 
                        CornerRadius="8" Margin="8" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Drop files or folders from Windows to import into NEXUS OS" 
                                   FontWeight="Bold" FontSize="16" Foreground="{DynamicResource NexusAccentBrush}" />
                    </StackPanel>
                </Border>

                <!-- Grid View (WrapPanel) -->
                <ScrollViewer x:Name="FilesGridScrollViewer" VerticalScrollBarVisibility="Auto" Padding="12">
                    <WrapPanel x:Name="FilesWrapPanel" ItemWidth="96" ItemHeight="96" />
                </ScrollViewer>

                <!-- Details View (ListView) -->
                <ListView x:Name="FilesListView" Visibility="Collapsed" Background="Transparent" BorderThickness="0"
                          MouseDoubleClick="FilesListView_MouseDoubleClick" SelectionChanged="FilesListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Date Modified" Width="160" DisplayMemberBinding="{Binding DateModified, StringFormat='yyyy-MM-dd HH:mm'}" />
                            <GridViewColumn Header="Type" Width="120" DisplayMemberBinding="{Binding Extension}" />
                            <GridViewColumn Header="Size" Width="100" DisplayMemberBinding="{Binding FormattedSize}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock x:Name="ItemCountTextBlock" Text="0 items" FontSize="11" Foreground="{DynamicResource NexusTextSecondaryBrush}" />
                <TextBlock x:Name="StatusMessageTextBlock" Text="Drag files from Windows Explorer to import" FontSize="11" Foreground="{DynamicResource NexusTextMutedBrush}" HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
