<UserControl x:Class="NexusOS.Apps.Games.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NexusOS.UI;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource NexusBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" /> <!-- Game Selector Header -->
            <RowDefinition Height="*" />  <!-- Active Game Canvas / Board -->
        </Grid.RowDefinitions>

        <!-- Games Navigation Bar -->
        <Border Grid.Row="0" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconGamepad}" Fill="{DynamicResource NexusAccentBrush}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="NEXUS ARCADE" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,20,0" />

                    <!-- Game Selector Buttons -->
                    <Button x:Name="BtnMinesweeper" Content="Minesweeper" Style="{StaticResource NexusButtonPrimary}" Margin="4,0" Padding="12,4" Click="SwitchGame_Click" Tag="Minesweeper" />
                    <Button x:Name="BtnSnake" Content="Cyber Snake" Style="{StaticResource NexusButtonGhost}" Margin="4,0" Padding="12,4" Click="SwitchGame_Click" Tag="Snake" />
                    <Button x:Name="BtnRunner" Content="2D Cyber Runner" Style="{StaticResource NexusButtonGhost}" Margin="4,0" Padding="12,4" Click="SwitchGame_Click" Tag="Runner" />
                    <Button x:Name="BtnSudoku" Content="Sudoku" Style="{StaticResource NexusButtonGhost}" Margin="4,0" Padding="12,4" Click="SwitchGame_Click" Tag="Sudoku" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Active Game Content Container -->
        <Grid Grid.Row="1">
            
            <!-- 1. MINESWEEPER CONTAINER -->
            <Grid x:Name="MinesweeperContainer" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="16">
                    <StackPanel>
                        <!-- Minesweeper Header Bar -->
                        <Border Background="{DynamicResource NexusBackgroundBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock x:Name="MinesRemainingText" Text="010" FontFamily="Consolas" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource NexusDangerBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="MinesweeperTimerText" Text="000" FontFamily="Consolas" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource NexusDangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <Button x:Name="MinesweeperResetButton" Content="😊" Width="36" Height="36" FontSize="16" HorizontalAlignment="Center" Click="MinesweeperReset_Click" />
                            </DockPanel>
                        </Border>

                        <!-- 9x9 Minesweeper Grid -->
                        <UniformGrid x:Name="MinesweeperGrid" Columns="9" Rows="9" Width="360" Height="360" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. CYBER SNAKE CONTAINER -->
            <Grid x:Name="SnakeContainer" Visibility="Collapsed" Focusable="True" KeyDown="Snake_KeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource NexusSurfaceBrush}" Padding="16,8" Margin="0,0,0,8">
                    <DockPanel>
                        <TextBlock Text="Use Arrow Keys or WASD to Move" FontSize="12.5" Foreground="{DynamicResource NexusTextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="SnakeScoreText" Text="Score: 0" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource NexusAccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button x:Name="SnakeStartButton" Content="Start / Restart" Style="{StaticResource NexusButtonPrimary}" Padding="12,4" Click="SnakeStart_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource NexusBackgroundBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="2" CornerRadius="8" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas x:Name="SnakeCanvas" Width="480" Height="400" Background="#070A12" ClipToBounds="True" />
                </Border>
            </Grid>

            <!-- 3. 2D CYBER RUNNER CONTAINER -->
            <Grid x:Name="RunnerContainer" Visibility="Collapsed" Focusable="True" KeyDown="Runner_KeyDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource NexusSurfaceBrush}" Padding="16,8">
                    <DockPanel>
                        <TextBlock Text="Press SPACEBAR or UP to Jump over Obstacles!" FontSize="12.5" Foreground="{DynamicResource NexusTextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="RunnerScoreText" Text="Distance: 0m" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource NexusSuccessBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="Play / Jump" Style="{StaticResource NexusButtonPrimary}" Padding="12,4" Click="RunnerJump_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#0A0E1A" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="2" CornerRadius="8" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas x:Name="RunnerCanvas" Width="600" Height="340" ClipToBounds="True" />
                </Border>
            </Grid>

            <!-- 4. SUDOKU CONTAINER -->
            <Grid x:Name="SudokuContainer" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="2" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="NEXUS SUDOKU" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <Button Content="New Puzzle" Style="{StaticResource NexusButtonPrimary}" HorizontalAlignment="Right" Padding="12,4" Click="SudokuNewGame_Click" />
                        </DockPanel>

                        <!-- 9x9 Sudoku Board -->
                        <Border BorderBrush="{DynamicResource NexusAccentBrush}" BorderThickness="2">
                            <UniformGrid x:Name="SudokuGrid" Columns="9" Rows="9" Width="360" Height="360" />
                        </Border>

                        <!-- Digits Palette (1-9) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Content="1" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="1" />
                            <Button Content="2" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="2" />
                            <Button Content="3" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="3" />
                            <Button Content="4" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="4" />
                            <Button Content="5" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="5" />
                            <Button Content="6" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="6" />
                            <Button Content="7" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="7" />
                            <Button Content="8" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="8" />
                            <Button Content="9" Width="32" Height="32" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuDigit_Click" Tag="9" />
                            <Button Content="Clear" Padding="8,4" Margin="3" Style="{StaticResource NexusButtonGhost}" Click="SudokuClearCell_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
