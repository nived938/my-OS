<UserControl x:Class="NexusOS.Apps.Browser.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NexusOS.UI;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource NexusBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" /> <!-- Tabs -->
            <RowDefinition Height="46" /> <!-- Navigation & URL Bar -->
            <RowDefinition Height="32" /> <!-- Bookmarks Bar -->
            <RowDefinition Height="*" />  <!-- Web View & Downloads Overlay -->
        </Grid.RowDefinitions>

        <!-- Browser Tabs -->
        <Border Grid.Row="0" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderSubtleBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button x:Name="NewTabBtn" Content="+" Style="{StaticResource NexusButtonGhost}" Width="30" Height="28" Padding="0" Margin="4,4" Click="NewTabBtn_Click" ToolTip="New Tab" />
                <StackPanel x:Name="BrowserTabsContainer" Orientation="Horizontal" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Navigation Bar -->
        <Border Grid.Row="1" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back, Forward, Reload, Home -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <Button x:Name="BackBtn" Content="←" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="BackBtn_Click" />
                    <Button x:Name="ForwardBtn" Content="→" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="ForwardBtn_Click" />
                    <Button x:Name="ReloadBtn" Content="↻" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="ReloadBtn_Click" />
                    <Button x:Name="HomeBtn" Content="⌂" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Padding="0" Margin="2,0" Click="HomeBtn_Click" />
                </StackPanel>

                <!-- Address & Search Bar -->
                <TextBox x:Name="UrlTextBox" Grid.Column="1" Style="{StaticResource NexusTextBox}" 
                         VerticalAlignment="Center" Padding="12,6" KeyDown="UrlTextBox_KeyDown" />

                <!-- Downloads & Bookmarks Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="DownloadsBtn" Content="Downloads" Style="{StaticResource NexusButtonGhost}" Margin="2,0" Click="DownloadsBtn_Click" />
                    <Button x:Name="BookmarkCurrentBtn" Content="★" Style="{StaticResource NexusButtonGhost}" Width="32" Height="32" Margin="2,0" Click="BookmarkCurrentBtn_Click" ToolTip="Bookmark this page" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bookmarks Bar -->
        <Border Grid.Row="2" Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="8,2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="DuckDuckGo" Style="{StaticResource NexusButtonGhost}" Padding="8,2" Margin="2,0" Click="Bookmark_Click" Tag="https://duckduckgo.com" />
                <Button Content="GitHub" Style="{StaticResource NexusButtonGhost}" Padding="8,2" Margin="2,0" Click="Bookmark_Click" Tag="https://github.com" />
                <Button Content="Wikipedia" Style="{StaticResource NexusButtonGhost}" Padding="8,2" Margin="2,0" Click="Bookmark_Click" Tag="https://wikipedia.org" />
                <Button Content="Download VS Code" Style="{StaticResource NexusButtonGhost}" Padding="8,2" Margin="2,0" Click="DownloadSampleExe_Click" Tag="https://code.visualstudio.com" />
            </StackPanel>
        </Border>

        <!-- Web Content Display Area -->
        <Grid Grid.Row="3">
            <!-- Real Chromium WebView2 Control -->
            <wv2:WebView2 x:Name="CoreWebView" Visibility="Visible" />

            <!-- Fallback Web Page when WebView2 is loading / offline -->
            <Border x:Name="FallbackWebPage" Background="{DynamicResource NexusBackgroundBrush}" Visibility="Collapsed" Padding="40">
                <StackPanel MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="NEXUS NAVIGATOR" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource NexusAccentBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="Fast, modern Chromium web browsing inside NEXUS OS." FontSize="14" Foreground="{DynamicResource NexusTextSecondaryBrush}" Margin="0,0,0,24" />
                    
                    <Border Background="{DynamicResource NexusSurfaceBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Download Test Program (.exe)" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                            <TextBlock Text="Download and inspect a safe Windows executable installer inside Nexus OS:" FontSize="12" Foreground="{DynamicResource NexusTextSecondaryBrush}" Margin="0,0,0,12" />
                            <Button Content="Download Demo Installer (demo-installer.exe)" Style="{StaticResource NexusButtonPrimary}" Click="SimulateExeDownload_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Downloads Panel Overlay (Slide-over on the right side) -->
            <Border x:Name="DownloadsDrawer" Width="340" HorizontalAlignment="Right" Background="{DynamicResource NexusSurfaceTranslucentBrush}"
                    BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <Button Content="Close" Style="{StaticResource NexusButtonGhost}" HorizontalAlignment="Right" Padding="8,2" Click="CloseDownloads_Click" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DownloadsListContainer" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
