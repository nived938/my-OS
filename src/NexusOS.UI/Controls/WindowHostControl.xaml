<UserControl x:Class="NexusOS.UI.Controls.WindowHostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DropShadowEffect x:Key="ActiveWindowShadow" BlurRadius="24" ShadowDepth="8" Direction="270" Color="Black" Opacity="0.45" />
            <DropShadowEffect x:Key="InactiveWindowShadow" BlurRadius="12" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.25" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <!-- Main Window Container -->
        <Border x:Name="WindowBorder"
                Background="{DynamicResource NexusSurfaceBrush}"
                BorderBrush="{DynamicResource NexusBorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource WindowCornerRadius}"
                Effect="{StaticResource ActiveWindowShadow}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Window Title Bar -->
                <Border x:Name="TitleBar" Grid.Row="0"
                        Background="{DynamicResource NexusSurfaceHoverBrush}"
                        CornerRadius="9,9,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        MouseMove="TitleBar_MouseMove"
                        MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- App Icon and Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                            <Path x:Name="AppIconPath" 
                                  Data="{DynamicResource IconFolder}"
                                  Fill="{DynamicResource NexusAccentBrush}" 
                                  Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TitleTextBlock" Text="Window Title"
                                       FontWeight="Medium" FontSize="12.5"
                                       Foreground="{DynamicResource NexusTextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Control Buttons (Min, Max, Close) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PinButton" Style="{StaticResource NexusTitleBarButton}" Click="PinButton_Click" ToolTip="Always on Top">
                                <Path Data="{StaticResource IconPin}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="MinimizeButton" Style="{StaticResource NexusTitleBarButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                                <Path Data="{StaticResource IconMinimize}" Stroke="{DynamicResource NexusTextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="2" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource NexusTitleBarButton}" Click="MaximizeButton_Click" ToolTip="Maximize / Restore">
                                <Path x:Name="MaximizeIcon" Data="{StaticResource IconMaximize}" Stroke="{DynamicResource NexusTextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource NexusTitleBarCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                                <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource NexusTextSecondaryBrush}" StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Window Content -->
                <ContentPresenter x:Name="WindowContentPresenter" Grid.Row="1" />
            </Grid>
        </Border>

        <!-- 8 Resize Hitboxes (Transparent borders overlaid on edges/corners) -->
        <!-- Edges -->
        <Border x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
        <Border x:Name="ResizeRight" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
        <Border x:Name="ResizeTop" Height="6" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
        <Border x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeNS" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />

        <!-- Corners -->
        <Border x:Name="ResizeTopLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNWSE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
        <Border x:Name="ResizeTopRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNESW" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
        <Border x:Name="ResizeBottomLeft" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNESW" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
        <Border x:Name="ResizeBottomRight" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNWSE" MouseDown="Resize_MouseDown" MouseMove="Resize_MouseMove" MouseUp="Resize_MouseUp" />
    </Grid>
</UserControl>
