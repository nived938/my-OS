<UserControl x:Class="NexusOS.UI.Controls.AltTabOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="650">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DropShadowEffect x:Key="AltTabShadow" BlurRadius="40" ShadowDepth="12" Direction="270" Color="Black" Opacity="0.6" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource NexusSurfaceTranslucentBrush}"
            BorderBrush="{DynamicResource NexusBorderBrush}"
            BorderThickness="1.5"
            CornerRadius="14"
            Padding="20"
            Effect="{StaticResource AltTabShadow}">
        
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="Running Applications (Alt + Tab)" FontWeight="SemiBold" FontSize="13" 
                       Foreground="{DynamicResource NexusTextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="WindowsContainer" Orientation="Horizontal" HorizontalAlignment="Center" />
            </ScrollViewer>
        </StackPanel>
    </Border>
</UserControl>
