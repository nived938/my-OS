<UserControl x:Class="NexusOS.UI.Controls.TaskbarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="48" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="TaskbarIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" 
                                    CornerRadius="6" Padding="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NexusSurfaceHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource NexusBorderBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Taskbar Container: Translucent Acrylic Material -->
    <Border Background="{DynamicResource NexusSurfaceTranslucentBrush}"
            BorderBrush="{DynamicResource NexusBorderBrush}"
            BorderThickness="0,1,0,0">
        
        <Grid Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left / Center Section: Start, Search, Apps -->
            <StackPanel x:Name="AppIconsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Start Button -->
                <Button x:Name="StartButton" Style="{StaticResource TaskbarIconButton}" Click="StartButton_Click" ToolTip="Start (Nexus)">
                    <Path Data="{StaticResource IconStart}" Fill="{DynamicResource NexusAccentBrush}" Width="20" Height="20" Stretch="Uniform" />
                </Button>

                <!-- Search Button -->
                <Button x:Name="SearchButton" Style="{StaticResource TaskbarIconButton}" Click="SearchButton_Click" ToolTip="Search Apps, Files &amp; Settings">
                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="18" Height="18" Stretch="Uniform" />
                </Button>

                <!-- Separator -->
                <Rectangle Width="1" Height="24" Fill="{DynamicResource NexusBorderSubtleBrush}" Margin="6,0" />

                <!-- Dynamic Running & Pinned App Buttons Container -->
                <StackPanel x:Name="RunningAppsContainer" Orientation="Horizontal" />
            </StackPanel>

            <!-- Right Section: System Tray (Network, Volume, Battery, Clock, Notifications, Show Desktop) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                
                <!-- Network Status -->
                <Button Style="{StaticResource TaskbarIconButton}" Click="QuickSettings_Click" ToolTip="Internet Connected">
                    <Path Data="{StaticResource IconWifi}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Volume Status -->
                <Button Style="{StaticResource TaskbarIconButton}" Click="QuickSettings_Click" ToolTip="Volume">
                    <Path Data="{StaticResource IconVolume}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Battery Status -->
                <Button x:Name="BatteryButton" Style="{StaticResource TaskbarIconButton}" Click="QuickSettings_Click" ToolTip="Power Status">
                    <Path Data="{StaticResource IconBattery}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <!-- Live Clock & Date -->
                <Button x:Name="ClockButton" Background="Transparent" BorderThickness="0" Margin="4,0" Padding="8,4" Cursor="Hand" Click="ClockButton_Click">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TimeTextBlock" Text="12:00 PM" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="DateTextBlock" Text="2026-10-21" FontSize="10.5" Foreground="{DynamicResource NexusTextSecondaryBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Button>

                <!-- Action Center / Notifications Button -->
                <Button x:Name="NotificationCenterButton" Style="{StaticResource TaskbarIconButton}" Click="NotificationCenterButton_Click" ToolTip="Notification Center">
                    <Grid>
                        <Path Data="{StaticResource IconBell}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                        <Border x:Name="UnreadBadge" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource NexusAccentBrush}" 
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Show Desktop Peek Button (Windows 11 style sliver at the far right) -->
                <Border x:Name="ShowDesktopButton" Width="6" Height="40" Background="Transparent" Cursor="Hand" 
                        Margin="4,0,2,0" MouseLeftButtonDown="ShowDesktopButton_Click" ToolTip="Show Desktop" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
