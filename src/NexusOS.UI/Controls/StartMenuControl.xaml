<UserControl x:Class="NexusOS.UI.Controls.StartMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="560"
             Width="560" Height="620">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DropShadowEffect x:Key="FlyoutShadow" BlurRadius="32" ShadowDepth="12" Direction="270" Color="Black" Opacity="0.5" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Translucent Acrylic Glass Container -->
    <Border Background="{DynamicResource NexusSurfaceTranslucentBrush}"
            BorderBrush="{DynamicResource NexusBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Effect="{StaticResource FlyoutShadow}">

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Search Box -->
                <RowDefinition Height="Auto" /> <!-- Pinned Header -->
                <RowDefinition Height="*" />    <!-- Apps Grid / Search Results -->
                <RowDefinition Height="Auto" /> <!-- Recommended / Recent Files -->
                <RowDefinition Height="Auto" /> <!-- User Profile & Power Bar -->
            </Grid.RowDefinitions>

            <!-- Search Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBox x:Name="SearchTextBox" Style="{StaticResource NexusTextBox}" 
                         Padding="36,10,12,10" FontSize="13.5"
                         TextChanged="SearchTextBox_TextChanged" />
                <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource NexusTextSecondaryBrush}" 
                      Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder" Text="Type here to search apps, files, settings..." 
                           Foreground="{DynamicResource NexusTextMutedBrush}" VerticalAlignment="Center"
                           Margin="38,0,0,0" IsHitTestVisible="False" />
            </Grid>

            <!-- Pinned Section Header -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="Pinned" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource NexusTextPrimaryBrush}" />
                <Button x:Name="AllAppsButton" Content="All apps >" Style="{StaticResource NexusButtonGhost}" 
                        HorizontalAlignment="Right" Padding="8,2" FontSize="12" Click="AllAppsButton_Click" />
            </Grid>

            <!-- Apps Container (WrapPanel in ScrollViewer) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <WrapPanel x:Name="AppsWrapPanel" ItemWidth="84" ItemHeight="84" />
            </ScrollViewer>

            <!-- Recommended / Recent Files -->
            <Border Grid.Row="3" Background="{DynamicResource NexusSurfaceBrush}" 
                    BorderBrush="{DynamicResource NexusBorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Recommended &amp; Recent" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6" />
                    <StackPanel x:Name="RecentFilesContainer" />
                </StackPanel>
            </Border>

            <!-- Footer: User Profile & Power Actions -->
            <Grid Grid.Row="4" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- User Profile -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource NexusAccentBrush}">
                        <TextBlock Text="NX" FontWeight="Bold" FontSize="14" Foreground="White" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Nexus User" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="Local Profile" FontSize="11" Foreground="{DynamicResource NexusTextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Settings & Power Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SettingsShortcutButton" Style="{StaticResource NexusButtonGhost}" 
                            Margin="0,0,8,0" Padding="8" ToolTip="Nexus Settings" Click="SettingsShortcutButton_Click">
                        <Path Data="{StaticResource IconSettings}" Fill="{DynamicResource NexusTextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                    </Button>

                    <Button x:Name="PowerButton" Style="{StaticResource NexusButtonGhost}" 
                            Padding="8" ToolTip="Power Options" Click="PowerButton_Click">
                        <Path Data="{StaticResource IconPower}" Fill="{DynamicResource NexusDangerBrush}" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Power Options Popup -->
                <Popup x:Name="PowerPopup" PlacementTarget="{Binding ElementName=PowerButton}" 
                       Placement="Top" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource NexusSurfaceBrush}" BorderBrush="{DynamicResource NexusBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8" Effect="{StaticResource FlyoutShadow}">
                        <StackPanel Width="220">
                            <Button Style="{StaticResource NexusButtonGhost}" HorizontalContentAlignment="Left" Click="LockNexus_Click" Margin="0,2">
                                <TextBlock Text="Lock Nexus OS" />
                            </Button>
                            <Button Style="{StaticResource NexusButtonGhost}" HorizontalContentAlignment="Left" Click="RestartNexus_Click" Margin="0,2">
                                <TextBlock Text="Restart Nexus OS" />
                            </Button>
                            <Button Style="{StaticResource NexusButtonGhost}" HorizontalContentAlignment="Left" Click="ExitNexus_Click" Margin="0,2">
                                <TextBlock Text="Exit Nexus to Windows" />
                            </Button>
                            <Separator Background="{DynamicResource NexusBorderSubtleBrush}" Margin="0,4" />
                            <!-- Host Windows Shutdown with Red Danger Styling -->
                            <Button Style="{StaticResource NexusButtonGhost}" HorizontalContentAlignment="Left" Click="HostShutdown_Click" Margin="0,2">
                                <TextBlock Text="Host PC Shutdown..." Foreground="{DynamicResource NexusDangerBrush}" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </Border>
</UserControl>
