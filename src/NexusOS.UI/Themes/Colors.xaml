<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme (Default) -->
    <Color x:Key="ColorBackground">#0B0F19</Color>
    <Color x:Key="ColorSurface">#151D2F</Color>
    <Color x:Key="ColorSurfaceTranslucent">#D9151D2F</Color>
    <Color x:Key="ColorSurfaceHover">#24304A</Color>
    <Color x:Key="ColorBorder">#2E3C5A</Color>
    <Color x:Key="ColorBorderSubtle">#1F2B42</Color>
    
    <Color x:Key="ColorTextPrimary">#F8FAFC</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>

    <Color x:Key="ColorAccent">#2563EB</Color>
    <Color x:Key="ColorAccentHover">#3B82F6</Color>
    <Color x:Key="ColorAccentPressed">#1D4ED8</Color>

    <Color x:Key="ColorSuccess">#10B981</Color>
    <Color x:Key="ColorWarning">#F59E0B</Color>
    <Color x:Key="ColorDanger">#EF4444</Color>

    <SolidColorBrush x:Key="NexusBackgroundBrush" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="NexusSurfaceBrush" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="NexusSurfaceTranslucentBrush" Color="{StaticResource ColorSurfaceTranslucent}" />
    <SolidColorBrush x:Key="NexusSurfaceHoverBrush" Color="{StaticResource ColorSurfaceHover}" />
    <SolidColorBrush x:Key="NexusBorderBrush" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="NexusBorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}" />

    <SolidColorBrush x:Key="NexusTextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="NexusTextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="NexusTextMutedBrush" Color="{StaticResource ColorTextMuted}" />

    <SolidColorBrush x:Key="NexusAccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="NexusAccentHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="NexusAccentPressedBrush" Color="{StaticResource ColorAccentPressed}" />

    <SolidColorBrush x:Key="NexusSuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="NexusWarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="NexusDangerBrush" Color="{StaticResource ColorDanger}" />

    <!-- Corner Radius Definitions -->
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">16</CornerRadius>

</ResourceDictionary>
